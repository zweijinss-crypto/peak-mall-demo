# ============================================================
# peak-mall-demo · Supabase env (Phase 1.1)
# ============================================================
# Copy to .env.local and fill in your Supabase project values.
# When these are missing the app falls back to localStorage mode.

# From Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

# Used by supabase/seed/seed-products.ts ONLY (server-side seed).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key
