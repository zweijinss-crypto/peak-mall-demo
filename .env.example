# ============================================================
# peak-mall-demo · environment
# ============================================================
# Copy to .env.local and fill in your values. Each section is
# independently optional — the app falls back to localStorage / mock
# payment when the corresponding vars are missing.

# ------------------------------------------------------------
# Supabase  (Phase 1.1)
# ------------------------------------------------------------
# From Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***

# Used by supabase/seed/seed-products.ts ONLY (server-side seed).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=***

# ------------------------------------------------------------
# Stripe  (Phase 1.2)
# ------------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_***
STRIPE_SECRET_KEY=sk_test_***

# From `stripe listen --forward-to ...` output OR Stripe Dashboard →
# Webhooks → Add endpoint → reveal signing secret
STRIPE_WEBHOOK_SECRET=whsec_***

# Stripe Price IDs (optional) — used by Checkout to pre-fill line items.
# Create products + prices in Stripe Dashboard → Products, paste the
# price IDs (price_...) here. If missing, Checkout falls back to
# `price_data` inline construction.
STRIPE_PRICE_LAPTOP=price_***
STRIPE_PRICE_HEADPHONES=price_***

# ------------------------------------------------------------
# Resend  (Phase 1.4 — transactional email)
# ------------------------------------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=re_***

# Verified sender (Resend requires a verified domain).
# For local testing, use the test sender: "Peak Mall <onboarding@resend.dev>"
RESEND_FROM=Peak Mall <onboarding@resend.dev>

# Public site URL used in email links (password reset, order detail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the Supabase Auth password reset redirect URL.
# Default uses NEXT_PUBLIC_SITE_URL/reset-password.
SUPABASE_RESET_REDIRECT_URL=

# ------------------------------------------------------------
# Sentry  (Phase 1.6 — error monitoring)
# ------------------------------------------------------------
# Browser-side DSN (safe to ship to client). From Sentry project
# Settings → Client Keys (DSN). Leave empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side DSN used by netlify/functions (e.g. stripe-webhook).
# Optional — if unset, server functions just log to stdout.
SENTRY_DSN=

# Optional: tag events with environment (default "production").
# Use "staging" for previews, "development" locally.
NEXT_PUBLIC_SENTRY_ENV=production

# Optional: pin release version (default: undefined).
NEXT_PUBLIC_SENTRY_RELEASE=

# Optional: trace sample rate 0.0–1.0 (default 0.1 = 10%).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
